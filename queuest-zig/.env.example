# .env.example  (committed; the real file lives on the server in ~/queuest/shared/.env)
# The service listens on 127.0.0.1:$PORT; Caddy is the public side.
PORT=3002
# Relative to the release directory; data/ is a symlink to ~/queuest/shared/data.
SQLITE_PATH=data/queuest.db
# Leave DEV unset in production (localhost CORS is off in release builds).
